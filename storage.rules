rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /novels/{novelId}/cover/{fileName} {
      // Les images de couverture peuvent être affichées aux lecteurs connectés.
      allow read: if request.auth != null;

      // Seul l'auteur du roman peut ajouter ou remplacer sa couverture.
      // Les fichiers acceptés sont des images JPG, PNG ou WebP de 5 Mo maximum.
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/novels/$(novelId)).data.authorId == request.auth.uid
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
  }
}